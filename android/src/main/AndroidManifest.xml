<?xml version="1.0" encoding="utf-8"?>
<!--
  LOCK46 V1.

  Every permission below has a specific technical reason and is listed with that reason in
  the app's own Settings screen. Note what is NOT here: no INTERNET, no location, no
  contacts, no call log, no SMS, no microphone, no camera, no QUERY_ALL_PACKAGES.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Restores duty state after a reboot so a restart cannot clear an active period. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keeps the enforcement service alive for the length of the duty period. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- The ongoing "Duty Mode active" notification (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Draws the LOCK46 blocking screen on top of a blocked app. User-granted in Settings. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Foreground-app detection. Special access, user-granted in Settings.

      This is how LOCK46 knows which app you just opened. An AccessibilityService would
      detect it faster, but Google Play Protect hard-blocks the installation of any
      sideloaded app that declares BIND_ACCESSIBILITY_SERVICE, so LOCK46 deliberately does
      not declare one — it polls UsageStats instead while a duty period is running.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets the user exempt LOCK46 from battery optimisation so duty is not cut short. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Package visibility (Android 11+). LOCK46 needs to list launchable apps for the
      picker and resolve the launcher / keyboard / dialer so they are never blocked.
      Declared narrowly instead of requesting QUERY_ALL_PACKAGES.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".Lock46App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:directBootAware="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LOCK46">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.LOCK46"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the process alive and ticks the duty clock.
          specialUse: this is device self-restriction, which none of Android's predefined
          foreground-service types describe.
        -->
        <service
            android:name=".enforce.DutyService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces a user-initiated, locally configured device duty period" />
        </service>

        <receiver
            android:name=".enforce.BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Backstop alarm: ends duty even if the service was killed and never restarted. -->
        <receiver
            android:name=".enforce.DutyExpiryReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lock46.app.action.DUTY_EXPIRED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
