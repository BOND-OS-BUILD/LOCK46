<?xml version="1.0" encoding="utf-8"?>
<!--
  The blocking screen, added to the window manager as a system overlay.

  Plain Android views rather than Compose: this view is attached directly by
  BlockOverlay via WindowManager, outside any Activity, so it has no lifecycle,
  saved-state or view-model owner for a ComposeView to hang off.

  Note there is deliberately no "disable LOCK46" control here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lock46_ink"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.25"
            android:text="@string/overlay_title"
            android:textColor="@color/lock46_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.2"
            android:text="@string/overlay_subtitle"
            android:textColor="@color/lock46_duty"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/lock46_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/overlay_message"
            android:textColor="@color/lock46_text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/overlay_blocked_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/lock46_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/overlay_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="monospace"
            android:textColor="@color/lock46_text_secondary"
            android:textSize="20sp" />

        <Button
            android:id="@+id/overlay_return_home"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="36dp"
            android:background="@color/lock46_duty"
            android:letterSpacing="0.15"
            android:text="@string/overlay_return_home"
            android:textColor="@color/lock46_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
